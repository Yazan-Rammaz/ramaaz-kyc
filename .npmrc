# wrangler ^4.123 peer-wants @cloudflare/workers-types ^5, but this Worker is
# typed against ^4: v5's globals shadow Node's Buffer, and cropToJpeg (photon
# image ops) returns a real Node Buffer whose .toString('base64') then fails to
# typecheck. That is a semantic change for a types-only peer warning, so the
# version is pinned and the peer conflict is accepted instead.
legacy-peer-deps=true
