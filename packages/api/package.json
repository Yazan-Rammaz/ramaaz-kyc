{
  "name": "@ramaaz/kyc-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy src/index.ts",
    "deploy:staging": "wrangler deploy src/index.ts --env staging",
    "deploy:production": "wrangler deploy src/index.ts --env production",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1037.0",
    "@aws-sdk/client-sts": "^3.1038.0",
    "@aws-sdk/client-textract": "^3.1037.0",
    "@cf-wasm/photon": "^0.3.6",
    "@zxing/library": "^0.22.0",
    "hono": "^4.6.0",
    "openai": "^6.35.0",
    "simli-client": "3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^20",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
