# Base URL of the deployed KYC Worker (packages/kyc-server in the rdb monorepo,
# until it moves here). No trailing slash. Example:
#   https://rdb-kyc.<account>.workers.dev
KYC_WORKER_BASE_URL=

# Shared HMAC secret used to verify hand-off tokens minted by NestJS.
# MUST match the signing secret on the NestJS side. Unset = every verification
# link is rejected (fail closed). Use a long random value; rotate on leak.
KYC_HANDOFF_SECRET=

# Absolute origins allowed as ?returnTo=. Comma-separated, no paths.
# Unconfigured means every verification link is rejected (fail closed).
NEXT_PUBLIC_KYC_ALLOWED_RETURN_ORIGINS=http://localhost:3000
